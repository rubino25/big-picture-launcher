<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="Root" TextElement.FontFamily="Segoe UI" UseLayoutRounding="True">

  <Grid.Resources>

    <!-- Tessera di un gioco -->
    <DataTemplate x:Key="GameTemplate">
      <Grid Width="220" Height="330">
        <Border CornerRadius="12">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#FF27325A" Offset="0"/>
              <GradientStop Color="#FF171D36" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <StackPanel VerticalAlignment="Center" Margin="12">
            <Image Source="{Binding Thumb}" MaxWidth="196" MaxHeight="120" Stretch="Uniform"/>
            <TextBlock Text="{Binding Name}" Foreground="White" FontSize="20" FontWeight="SemiBold"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,18,0,0"
                       MaxHeight="110" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </Border>
        <Border CornerRadius="12">
          <Border.Background>
            <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill"/>
          </Border.Background>
        </Border>
      </Grid>
    </DataTemplate>

    <Style x:Key="GameItem" TargetType="ListBoxItem">
      <Setter Property="Margin" Value="14"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid x:Name="root" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
              </Grid.RenderTransform>
              <ContentPresenter/>
              <Border x:Name="ring" CornerRadius="15" Margin="-4" BorderThickness="4"
                      BorderBrush="#FF7CC4FF" Opacity="0"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Panel.ZIndex" Value="5"/>
                <Setter TargetName="ring" Property="Opacity" Value="1"/>
                <Setter TargetName="root" Property="Effect">
                  <Setter.Value>
                    <DropShadowEffect Color="#FF4DA3FF" BlurRadius="38" ShadowDepth="0" Opacity="0.8"/>
                  </Setter.Value>
                </Setter>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="root" Duration="0:0:0.12" To="1.1"
                          Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"/>
                      <DoubleAnimation Storyboard.TargetName="root" Duration="0:0:0.12" To="1.1"
                          Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="root" Duration="0:0:0.12" To="1"
                          Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"/>
                      <DoubleAnimation Storyboard.TargetName="root" Duration="0:0:0.12" To="1"
                          Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Voce di menu -->
    <DataTemplate x:Key="MenuTemplate">
      <DockPanel LastChildFill="True">
        <!-- Valore o tipo della voce, in un'etichetta a parte -->
        <Border x:Name="pill" DockPanel.Dock="Right" CornerRadius="13" Padding="13,4" Margin="18,0,0,0"
                Background="#59000000" VerticalAlignment="Center" MaxWidth="360">
          <TextBlock Text="{Binding Hint}" Foreground="#FFDCE6FF" FontSize="16" FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis"/>
        </Border>
        <TextBlock Text="{Binding Label}" Foreground="White" FontSize="23" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"/>
      </DockPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Hint}" Value="">
          <Setter TargetName="pill" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Hint}" Value="{x:Null}">
          <Setter TargetName="pill" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="MenuItemStyle" TargetType="ListBoxItem">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <!-- Ogni voce è un riquadro a sé: sfondo più chiaro del pannello, bordo e spazio tra una e l'altra -->
            <Border x:Name="bd" CornerRadius="11" Padding="22,15" Margin="0,5" Background="#FF222C4F"
                    BorderBrush="#30FFFFFF" BorderThickness="1.5">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="#80FFFFFF"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#FF2F6FEB"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="#FFB9D6FF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Tasto della tastiera a schermo -->
    <Style x:Key="KeyStyle" TargetType="ListBoxItem">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="bd" CornerRadius="9" Height="64" Margin="4" Background="#FF222B4D">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextElement.FontSize="25" TextElement.Foreground="White"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#FF2F6FEB"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Badge" TargetType="Border">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="CornerRadius" Value="17"/>
      <Setter Property="Margin" Value="26,0,10,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="BadgeText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#FF0B0F1A"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="HintButton" TargetType="StackPanel">
      <Setter Property="Orientation" Value="Horizontal"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Opacity" Value="0.7"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="CloseButton" TargetType="Border">
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="CornerRadius" Value="22"/>
      <Setter Property="Margin" Value="28,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Background" Value="#26FFFFFF"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#FFE5484D"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="HintText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="Foreground" Value="#FFC9D6F2"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Grid.Resources>

  <Grid.Background>
    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FF080B14" Offset="0"/>
      <GradientStop Color="#FF121A33" Offset="0.6"/>
      <GradientStop Color="#FF1C1538" Offset="1"/>
    </LinearGradientBrush>
  </Grid.Background>

  <Grid.RowDefinitions>
    <RowDefinition Height="104"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="84"/>
  </Grid.RowDefinitions>

  <!-- Intestazione -->
  <Grid Grid.Row="0" Margin="64,0,64,0">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <!-- Sezioni: si cambiano con LB / RB o cliccandole -->
      <Border Height="26" CornerRadius="13" Padding="10,0" Background="#33FFFFFF" VerticalAlignment="Center" Margin="0,4,14,0">
        <TextBlock Text="LB" FontSize="13" FontWeight="Bold" Foreground="#FFC9D6F2" VerticalAlignment="Center"/>
      </Border>
      <TextBlock x:Name="TabGames" Text="GIOCHI" FontSize="32" FontWeight="Light" Foreground="White"
                 Cursor="Hand" Background="Transparent"/>
      <TextBlock x:Name="TabApps" Text="APPLICAZIONI" FontSize="32" FontWeight="Light" Foreground="White"
                 Cursor="Hand" Background="Transparent" Margin="30,0,0,0"/>
      <Border Height="26" CornerRadius="13" Padding="10,0" Background="#33FFFFFF" VerticalAlignment="Center" Margin="14,4,0,0">
        <TextBlock Text="RB" FontSize="13" FontWeight="Bold" Foreground="#FFC9D6F2" VerticalAlignment="Center"/>
      </Border>
      <TextBlock x:Name="CountText" FontSize="20" Foreground="#FF8FA3C8" Margin="24,0,0,5" VerticalAlignment="Bottom"/>
      <TextBlock x:Name="StatusText" FontSize="18" Foreground="#FF6FB7FF" Margin="24,0,0,6" VerticalAlignment="Bottom"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
      <!-- Gioco ancora aperto, poi stato del sistema: batteria del controller, rete, volume -->
      <TextBlock x:Name="RunText" FontSize="16" FontWeight="SemiBold" Foreground="#FF4ADE80" VerticalAlignment="Center"
                 Margin="0,0,26,0" MaxWidth="320" TextTrimming="CharacterEllipsis"/>
      <TextBlock x:Name="SysText" FontSize="16" Foreground="#FF8FA3C8" VerticalAlignment="Center" Margin="0,0,26,0"/>
      <!-- Promemoria: l'unico comando che funziona quando il launcher non è in primo piano -->
      <Border Height="28" CornerRadius="14" Padding="12,0" Background="#33FFFFFF" VerticalAlignment="Center">
        <TextBlock Text="BACK + START" FontSize="13" FontWeight="Bold" Foreground="#FFC9D6F2" VerticalAlignment="Center"/>
      </Border>
      <TextBlock Text="Launcher" FontSize="17" Foreground="#FF8FA3C8" VerticalAlignment="Center" Margin="10,0,34,0"/>
      <TextBlock x:Name="ClockText" VerticalAlignment="Center" FontSize="30" FontWeight="Light" Foreground="White"/>
      <!-- Chiusura del programma (mouse) -->
      <Border x:Name="BtnClose" Style="{StaticResource CloseButton}" ToolTip="Esci">
        <Path Data="M0,0 L14,14 M14,0 L0,14" Stroke="White" StrokeThickness="2.4"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
    </StackPanel>
  </Grid>

  <!-- Griglia giochi -->
  <ListBox x:Name="GameList" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0"
           Focusable="False" ItemTemplate="{StaticResource GameTemplate}"
           ItemContainerStyle="{StaticResource GameItem}"
           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
           ScrollViewer.VerticalScrollBarVisibility="Hidden"
           ScrollViewer.CanContentScroll="False">
    <ListBox.ItemsPanel>
      <ItemsPanelTemplate>
        <WrapPanel HorizontalAlignment="Center" Margin="40,26,40,26"/>
      </ItemsPanelTemplate>
    </ListBox.ItemsPanel>
  </ListBox>

  <TextBlock x:Name="EmptyText" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Center"
             VerticalAlignment="Center" TextAlignment="Center" FontSize="28" FontWeight="Light"
             Foreground="#FFC9D6F2" LineHeight="44"
             Text="Nessun gioco"/>

  <!-- Avviso temporaneo -->
  <Border x:Name="Toast" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,18"
          Background="#F0222C4E" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="24"
          Padding="28,12" Opacity="0" IsHitTestVisible="False">
    <TextBlock x:Name="ToastText" FontSize="21" Foreground="White"/>
  </Border>

  <!-- Piè di pagina -->
  <Grid Grid.Row="2" Margin="64,0,64,0">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
      <TextBlock x:Name="SelName" FontSize="30" FontWeight="SemiBold" Foreground="White"
                 MaxWidth="900" TextTrimming="CharacterEllipsis"/>
      <TextBlock x:Name="SelSource" FontSize="19" Foreground="#FF8FA3C8" Margin="18,0,0,4" VerticalAlignment="Bottom"/>
    </StackPanel>
    <!-- I comandi sono anche pulsanti cliccabili con il mouse -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
      <StackPanel x:Name="BtnLaunch" Style="{StaticResource HintButton}">
        <Border Style="{StaticResource Badge}" Background="#FF4ADE80"><TextBlock Text="A" Style="{StaticResource BadgeText}"/></Border>
        <TextBlock Text="Avvia" Style="{StaticResource HintText}"/>
      </StackPanel>
      <StackPanel x:Name="BtnOptions" Style="{StaticResource HintButton}">
        <Border Style="{StaticResource Badge}" Background="#FF60A5FA"><TextBlock Text="X" Style="{StaticResource BadgeText}"/></Border>
        <TextBlock Text="Opzioni" Style="{StaticResource HintText}"/>
      </StackPanel>
      <StackPanel x:Name="BtnMenu" Style="{StaticResource HintButton}">
        <Border Style="{StaticResource Badge}" Background="#FFFACC15"><TextBlock Text="Y" Style="{StaticResource BadgeText}"/></Border>
        <TextBlock Text="Menu" Style="{StaticResource HintText}"/>
      </StackPanel>
      <StackPanel x:Name="BtnExit" Style="{StaticResource HintButton}">
        <Border Style="{StaticResource Badge}" Background="#FFF87171"><TextBlock Text="B" Style="{StaticResource BadgeText}"/></Border>
        <TextBlock Text="Esci" Style="{StaticResource HintText}"/>
      </StackPanel>
    </StackPanel>
  </Grid>

  <!-- Menu a comparsa -->
  <Grid x:Name="Overlay" Grid.RowSpan="3" Visibility="Collapsed" Background="#CC05070E">
    <Border Width="860" MaxHeight="940" HorizontalAlignment="Center" VerticalAlignment="Center"
            CornerRadius="18" Background="#FF10162B" BorderBrush="#4DFFFFFF" BorderThickness="1.5" Padding="30,26,30,22">
      <DockPanel>
        <TextBlock x:Name="MenuTitle" DockPanel.Dock="Top" FontSize="28" FontWeight="SemiBold" Foreground="White"
                   Margin="6,0,6,14" TextTrimming="CharacterEllipsis"/>
        <Border DockPanel.Dock="Top" Height="2" Background="#33FFFFFF" Margin="0,0,0,10"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
          <StackPanel x:Name="BtnMenuOk" Style="{StaticResource HintButton}">
            <Border Style="{StaticResource Badge}" Background="#FF4ADE80"><TextBlock Text="A" Style="{StaticResource BadgeText}"/></Border>
            <TextBlock Text="Seleziona" Style="{StaticResource HintText}"/>
          </StackPanel>
          <StackPanel x:Name="BtnMenuBack" Style="{StaticResource HintButton}">
            <Border Style="{StaticResource Badge}" Background="#FFF87171"><TextBlock Text="B" Style="{StaticResource BadgeText}"/></Border>
            <TextBlock Text="Indietro" Style="{StaticResource HintText}"/>
          </StackPanel>
        </StackPanel>
        <ListBox x:Name="MenuList" Background="Transparent" BorderThickness="0" Focusable="False"
                 ItemTemplate="{StaticResource MenuTemplate}" ItemContainerStyle="{StaticResource MenuItemStyle}"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Hidden"/>
      </DockPanel>
    </Border>
  </Grid>

  <!-- Standby: un gioco è stato avviato, il controller non comanda più il launcher -->
  <Grid x:Name="StandbyOverlay" Grid.RowSpan="3" Visibility="Collapsed" Background="#F005070E" Cursor="Hand">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock x:Name="StandbyTitle" FontSize="46" FontWeight="Light" Foreground="White" TextAlignment="Center"
                 MaxWidth="1500" TextTrimming="CharacterEllipsis"/>
      <TextBlock x:Name="StandbySub" FontSize="24" Foreground="#FF8FA3C8" TextAlignment="Center" Margin="0,14,0,0"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,56,0,0">
        <Border Height="36" CornerRadius="18" Padding="16,0" Background="#33FFFFFF" VerticalAlignment="Center" Margin="0,0,14,0">
          <TextBlock Text="BACK + START" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="Launcher" FontSize="22" Foreground="#FFC9D6F2" VerticalAlignment="Center"/>
      </StackPanel>
    </StackPanel>
  </Grid>

  <!-- Tastiera a schermo -->
  <Grid x:Name="KbOverlay" Grid.RowSpan="3" Visibility="Collapsed" Background="#E005070E">
    <Border Width="1200" HorizontalAlignment="Center" VerticalAlignment="Center"
            CornerRadius="18" Background="#FF151C33" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="30,26,30,22">
      <StackPanel>
        <TextBlock x:Name="KbTitle" FontSize="24" FontWeight="SemiBold" Foreground="White" Margin="6,0,6,0"
                   TextTrimming="CharacterEllipsis"/>
        <Border Background="#FF0A0F20" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="10"
                Padding="20,14" Margin="4,14,4,16">
          <TextBlock x:Name="KbText" FontSize="28" Foreground="White"/>
        </Border>
        <ListBox x:Name="KbList" Background="Transparent" BorderThickness="0" Focusable="False"
                 ItemContainerStyle="{StaticResource KeyStyle}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="10"/>
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
        </ListBox>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
          <Border Style="{StaticResource Badge}" Background="#FF4ADE80"><TextBlock Text="A" Style="{StaticResource BadgeText}"/></Border>
          <TextBlock Text="Scrivi" Style="{StaticResource HintText}"/>
          <Border Style="{StaticResource Badge}" Background="#FF60A5FA"><TextBlock Text="X" Style="{StaticResource BadgeText}"/></Border>
          <TextBlock Text="Cancella" Style="{StaticResource HintText}"/>
          <Border Style="{StaticResource Badge}" Background="#FFFACC15"><TextBlock Text="Y" Style="{StaticResource BadgeText}"/></Border>
          <TextBlock Text="Spazio" Style="{StaticResource HintText}"/>
          <Border Height="34" CornerRadius="17" Padding="14,0" Margin="26,0,10,0" Background="#FFCBD5E1" VerticalAlignment="Center">
            <TextBlock Text="START" Style="{StaticResource BadgeText}" FontSize="15"/>
          </Border>
          <TextBlock Text="Conferma" Style="{StaticResource HintText}"/>
          <Border Style="{StaticResource Badge}" Background="#FFF87171"><TextBlock Text="B" Style="{StaticResource BadgeText}"/></Border>
          <TextBlock Text="Annulla" Style="{StaticResource HintText}"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Grid>
